# ─────────────────────────────────────────────
#  LocalLink Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development          # development | production

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE=7d

# CORS — URL of your frontend (no trailing slash)
# Development:
CLIENT_URL=http://localhost:3000
# Production example:
# CLIENT_URL=https://locallink.your-domain.com

# ─── Email (OTP verification) ────────────────
# For development/testing use Mailtrap (https://mailtrap.io)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_username
MAILTRAP_PASS=your_mailtrap_password
EMAIL_FROM=noreply@locallink.dev

# For production replace the four MAILTRAP_* vars with your real SMTP provider:
# MAILTRAP_HOST=smtp.sendgrid.net
# MAILTRAP_PORT=587
# MAILTRAP_USER=apikey
# MAILTRAP_PASS=your_sendgrid_api_key

# ─── Cloudinary (image uploads) ──────────────
# Sign up free at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
