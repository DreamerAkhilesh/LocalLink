# ─────────────────────────────────────────────
#  LocalLink Frontend — Environment Variables
#  Copy this file to .env and fill in your values.
#  All variables MUST start with REACT_APP_ to be available in the browser.
# ─────────────────────────────────────────────

# Backend API base URL (include /api suffix, no trailing slash)
# Development: leave empty — the CRA proxy in package.json forwards to localhost:5000
# REACT_APP_API_URL=

# Production: point to your deployed backend
# REACT_APP_API_URL=https://api.your-domain.com/api
